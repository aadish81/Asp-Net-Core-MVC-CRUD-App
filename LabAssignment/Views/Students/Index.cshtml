


<div class="border pd-2" >
	<div class="row pd-3" >
		<p class="ml-3">
			<h5>Date: @DateTime.Now</h5>
		</p>
	</div>
	<div class="row mb-3">
		<h5>
			Name: Anonymous
		</h5>
		<h5>
			Roll Number: 00000
		</h5>
	</div>
	<div class="container">
		<div class="row p-2">
			<h5>Multiplication Table of (71+1)</h5>
			<div class="col-3">
				<table class="table table-bordered ">
			
					@for(int i=1;i<11;i++)
					{
						<tr>
							<td>72</td>
							<td>*</td>
							<td>@i</td>
							<td>=</td>
							<td>@(i*72)</td>
						</tr>
					}
				</table>
			</div>
		</div>
	</div>

</div>