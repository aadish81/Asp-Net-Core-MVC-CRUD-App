@model Student;

@{
	ViewData["Title"] = "Students";
}

<div class="container">
	<div class="row p-3">
		<div class="col-6">
			<h1>
				Student Info
			</h1>
		</div>
		<div class="col-6 text-end">
			<a asp-controller="Students" asp-action="NewStudent" class="btn btn-primary">Add Student</a>

		</div>

	</div>

</div>

<table class="table table-bordered table-striped">
	<tr>
		<td>
			StdId
		</td>
		<td>
			@Model.Id
		</td>
	</tr>
	<tr>
		<td>
			Name
		</td>
		<td>
			@Model.Name
		</td>
	</tr>
	<tr>
		<td>
			Address
		</td>
		<td>
			@Model.Address
		</td>
	</tr>
	<tr>
		<td>
			Faculty
		</td>
		<td>
			@Model.Faculty
		</td>
	</tr>
</table>

