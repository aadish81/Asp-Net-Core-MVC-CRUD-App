@model List<Student>;

@{
	ViewData["Title"] = "Students";
}

<div class="container">
	<div class="row p-3">
		<div class="col-6">
			<h1>
				Student Info
			</h1>
		</div>
		<div class="col-6 text-end">
			<a asp-controller="Students" asp-action="NewStudent" class="btn btn-primary">Add Student</a>

		</div>

	</div>

</div>

<table class="table table-bordered table-striped">
	<thead>
		<tr>
			<th>StdId</th>
			<th>Name</th>
			<th>Address</th>
			<th>Faculty</th>
			<th></th>
		</tr>
	</thead>
	<tbody>
		@foreach(var student in Model)
		{
			<tr>
				<td>@student.Id</td>
				<td>@student.Name</td>
				<td>@student.Address</td>
				<td>@student.Faculty</td>
				<td>
					<div class="w-75 btn-group" role="group">
						<a asp-controller="Students" asp-action="Edit" asp-route-id =" @student.Id" class="btn btn-dark mx-2">
							Edit
						</a>
						<a asp-controller="Students" asp-action="Delete" asp-route-id=" @student.Id" class="btn btn-danger mx-2">
							Delete
						</a>
					</div>
				</td>
			</tr>
		}
	</tbody>
</table>

